<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <GameVer Condition="'$(GameVer)' == ''">24</GameVer>
    <TargetFramework Condition="'$(GameVer)' == '24'">net10.0</TargetFramework>
    <TargetFramework Condition="'$(GameVer)' != '24'">netstandard2.0</TargetFramework>
    <AssemblyName>HealthBars</AssemblyName>
    <RootNamespace>Game</RootNamespace>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="HealthBars.cs" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Engine">
      <HintPath>libs/Engine$(GameVer).dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="EntitySystem">
      <HintPath>libs/EntitySystem$(GameVer).dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Survivalcraft">
      <HintPath>libs/Survivalcraft$(GameVer).dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
